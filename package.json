{
  "name": "money-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:schema": "wrangler d1 execute money-manager --local --file=./db/schema.sql",
    "db:schema:remote": "wrangler d1 execute money-manager --remote --file=./db/schema.sql"
  },
  "dependencies": {
    "lucide-react": "0.400.0",
    "next": "^16.3.4",
    "react": "19.1.9",
    "react-dom": "19.1.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260905.1",
    "@opennextjs/cloudflare": "1.20.6",
    "@types/node": "20.14.9",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.19",
    "postcss": "^8.5.28",
    "tailwindcss": "3.4.4",
    "typescript": "5.5.3",
    "wrangler": "4.129.0"
  }
}
